{
  "info": {
    "_postman_id": "9b128537-8e6d-4b8c-bca1-74f8899824de",
    "name": "CareerCoach – AI Resume and Interview Assistant API",
    "description": "Production-ready Postman collection for testing all CareerCoach MERN endpoints: Authentication (JWT & Refresh Token), Candidate Profile management, Rate-limited AI Resume & Interview Generation, Generation History, and RBAC-protected Admin Aggregation Usage Reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Candidate User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Developer\",\n  \"email\": \"alex.developer@example.com\",\n  \"password\": \"Secret@123456\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a standard candidate user. Returns user details, accessToken (15m), and refreshToken (7d)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register Admin User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Supervisor\",\n  \"email\": \"admin@careercoach.com\",\n  \"password\": \"Admin@123456\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers an administrative user with role 'admin' for accessing RBAC routes and analytics."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.developer@example.com\",\n  \"password\": \"Secret@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user credentials and sets accessToken and refreshToken collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}",
                  "pm.test('Status code is 200 and tokens returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@careercoach.com\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in the administrator to retrieve an admin-scoped JWT accessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}",
                  "pm.test('Admin logged in successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.user.role).to.eql('admin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Exchanges a valid refresh token for a newly minted 15-minute access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes the active refresh token in the database."
          }
        }
      ]
    },
    {
      "name": "2. Candidate Profile",
      "item": [
        {
          "name": "Create or Update Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\"JavaScript\", \"React.js\", \"Node.js\", \"Express\", \"MongoDB\", \"System Design\", \"REST APIs\"],\n  \"education\": [\n    {\n      \"institution\": \"Stanford University\",\n      \"degree\": \"Bachelor of Science\",\n      \"fieldOfStudy\": \"Computer Science\",\n      \"startYear\": 2019,\n      \"endYear\": 2023\n    }\n  ],\n  \"experience\": [\n    {\n      \"company\": \"Apex Cloud Innovations\",\n      \"role\": \"Full Stack Software Engineer\",\n      \"duration\": \"2023 - Present\",\n      \"responsibilities\": \"Architected microservices, improved database query speed by 35%, and deployed containerized React applications.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile"]
            },
            "description": "Upserts candidate profile with schema-validated skills, education, and experience."
          }
        },
        {
          "name": "Get Candidate Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile"]
            },
            "description": "Fetches current authenticated candidate's profile."
          }
        }
      ]
    },
    {
      "name": "3. AI Generation (Rate-Limited)",
      "item": [
        {
          "name": "Generate Tailored Resume Content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetRole\": \"Senior Full Stack Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/generate/resume",
              "host": ["{{baseUrl}}"],
              "path": ["api", "generate", "resume"]
            },
            "description": "Rate-limited (max 10/day). Uses native fetch to call AI model and saves tailored resume summary and quantified bullet points to MongoDB."
          }
        },
        {
          "name": "Generate Mock Interview Questions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetRole\": \"Senior Full Stack Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/generate/interview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "generate", "interview"]
            },
            "description": "Rate-limited (max 10/day). Generates 5 tailored technical & behavioral interview questions with STAR answer frameworks based on user's profile."
          }
        },
        {
          "name": "Get User Generation History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/generate/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "generate", "history"]
            },
            "description": "Returns all saved AI generation records for logged-in user, sorted newest first via indexed compound query."
          }
        }
      ]
    },
    {
      "name": "4. Admin Analytics (RBAC Protected)",
      "item": [
        {
          "name": "Get Admin Usage Report (Aggregation)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/usage-report",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "usage-report"]
            },
            "description": "Requires 'admin' role. Executes MongoDB aggregation pipeline ($group, $lookup, $sort) on Generation collection to calculate total generations, resume count, and interview count per user."
          }
        }
      ]
    }
  ]
}
